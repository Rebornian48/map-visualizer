{
  "name": "map-visualizer",
  "version": "1.0.0",
  "description": "Interactive web visualizer for Google Location History Timeline.json",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tiles:build": "node scripts/build-pmtiles.mjs",
    "tiles:list": "node scripts/build-pmtiles.mjs --list",
    "tiles:build:boundaries": "node scripts/build-pmtiles.mjs --group boundaries",
    "tiles:build:sda": "node scripts/build-pmtiles.mjs --group sda",
    "tiles:build:sarpras": "node scripts/build-pmtiles.mjs --group sarpras"
  },
  "dependencies": {
    "@geoman-io/leaflet-geoman-free": "^2.20.4",
    "@mapbox/shp-write": "^0.4.3",
    "@turf/turf": "^7.4.0",
    "html-to-image": "^1.11.13",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^6.9.1",
    "pmtiles": "^4.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "shpjs": "^6.2.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.0"
  }
}
